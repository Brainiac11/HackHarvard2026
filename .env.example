# Copy to .env (git-ignored) and fill in. The hub and handpose read it at startup: restart scripts/dev.sh after edits.

# xAI (Grok Voice, Grok Imagine)
XAI_API_KEY=
IMAGINE_MODEL=grok-imagine-image
VOICE_MODEL=grok-voice-latest

# Glove transport: null | ble | serial:/dev/ttyUSB0 | espcmd (temporary text-command firmware in bluetooth_ESP32/)
GLOVE_TRANSPORT=null
# NFC backend: auto | pcsc | hid:/dev/input/by-id/... | serial:/dev/ttyACM0 | none
NFC_BACKEND=auto
# Which hand wears the glove: any | left | right. The laptop hand tracker then ignores the bare hand.
GLOVE_HAND=any
# Laptop hand tracker (scripts/dev.sh --anyhand): the model it loads first, wilor | hamer (the phone's Engine button
# switches), and HaMeR's checkpoint: original (geopavlakos/hamer) | anyhand (AnyHand's fine-tune) | path/to/x.ckpt
HAND_MODEL=wilor
HAMER_WEIGHTS=original

# Chalk Mission Assistant
CHALK_ENV_ID=
CHALK_ROUTER_API_KEY=
AGENT_MODEL=
JUDGE_MODEL=
